# Configurações do Deal Hunters Chatbot
# Copie este arquivo para .env caso deseje personalizar variáveis localmente

APP_NAME=Deal Hunters
BOT_NAME=Hunter

# Banco de dados SQLite (padrão local)
# DATABASE_URL=sqlite:///dealhunters.db

# API CheapShark (gratuita e sem API key; exige User-Agent descritivo)
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0
CHEAPSHARK_USER_AGENT=DealHuntersBot/1.0 (Projeto Academico Chatbot Python; contato@dealhunters.local)

# Cotação USD -> BRL (AwesomeAPI gratuita, com taxa padrão de contingência)
EXCHANGE_RATE_URL=https://economia.awesomeapi.com.br/json/last/USD-BRL
DEFAULT_USD_BRL_RATE=5.80

# Resiliência de rede
API_TIMEOUT_SECONDS=8.0
API_MAX_RETRIES=2
# Defina como 1 para simular modo offline / contingência na apresentação
DEALHUNTERS_OFFLINE=0

# NLU e Regras de Negócio
SPACY_MODEL_NAME=pt_core_news_sm
NLU_CONFIDENCE_THRESHOLD=0.35
MAX_CONSECUTIVE_FALLBACKS=2

# Interface Web opcional
HOST=0.0.0.0
PORT=8000
